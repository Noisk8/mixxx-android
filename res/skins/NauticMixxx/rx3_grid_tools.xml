<!DOCTYPE template>
<Template>
  <WidgetGroup>
    <ObjectName>RX3GridTools</ObjectName>
    <Layout>vertical</Layout>
    <Size>0me,70f</Size>
    <Children>
      <Label>
        <ObjectName>RX3ModeTitle</ObjectName>
        <Rx3ModeTitle>true</Rx3ModeTitle>
        <Text>GRID</Text>
        <Size>0me,16f</Size>
      </Label>
      <WidgetGroup>
        <ObjectName>RX3GridToolRow</ObjectName>
        <Layout>horizontal</Layout>
        <Size>0me,40f</Size>
        <Children>
          <PushButton><Rx3MemoryButton>true</Rx3MemoryButton><Channel><Variable name="channel"/></Channel><ObjectName>RX3GridTool</ObjectName><Size>0me,40f</Size><NumberStates>1</NumberStates><State><Number>0</Number><Text>MEMORY</Text></State></PushButton>
          <PushButton>
            <ObjectName>RX3GridTool</ObjectName>
            <Size>0me,40f</Size>
            <NumberStates>1</NumberStates>
            <State>
              <Number>0</Number>
              <Text>SNAP GRID (CUE)</Text>
            </State>
            <Connection>
              <ConfigKey>[RX3Controller],grid_snap_cue</ConfigKey>
              <ConnectValueToWidget>false</ConnectValueToWidget>
            </Connection>
          </PushButton>
          <PushButton>
            <ObjectName>RX3GridTool</ObjectName>
            <Size>0me,40f</Size>
            <NumberStates>1</NumberStates>
            <State>
              <Number>0</Number>
              <Text>SHIFT GRID</Text>
            </State>
            <Connection>
              <ConfigKey>[RX3Display],gridshift<Variable name="channel" />
              </ConfigKey>
              <BindProperty>highlight</BindProperty>
            </Connection>
            <Connection>
              <ConfigKey>[RX3Controller],grid_shift</ConfigKey>
              <ConnectValueToWidget>false</ConnectValueToWidget>
            </Connection>
          </PushButton>
          <PushButton>
            <ObjectName>RX3GridTool</ObjectName>
            <Size>0me,40f</Size>
            <NumberStates>1</NumberStates>
            <State>
              <Number>0</Number>
              <Text>◂ 1/2</Text>
            </State>
            <Connection>
              <ConfigKey>[RX3Controller],grid_earlier_half</ConfigKey>
              <ConnectValueToWidget>false</ConnectValueToWidget>
            </Connection>
          </PushButton>
          <PushButton>
            <ObjectName>RX3GridTool</ObjectName>
            <Size>0me,40f</Size>
            <NumberStates>1</NumberStates>
            <State>
              <Number>0</Number>
              <Text>1/2 ▸</Text>
            </State>
            <Connection>
              <ConfigKey>[RX3Controller],grid_later_half</ConfigKey>
              <ConnectValueToWidget>false</ConnectValueToWidget>
            </Connection>
          </PushButton>
          <PushButton>
            <ObjectName>RX3GridTool</ObjectName>
            <Size>0me,40f</Size>
            <NumberStates>1</NumberStates>
            <State>
              <Number>0</Number>
              <Text>RESET</Text>
            </State>
            <Connection>
              <ConfigKey>[RX3Controller],grid_reset</ConfigKey>
              <ConnectValueToWidget>false</ConnectValueToWidget>
            </Connection>
          </PushButton>
        </Children>
      </WidgetGroup>
    </Children>
  </WidgetGroup>
</Template>
