  border-top: 2px solid #02a6d5;
  border-radius: 0;
  margin: 0 5px 7px 5px;
}

#DeckHeader {
  background-color: #202326;
  border-bottom: 1px solid #050607;
  min-height: 35px;
  max-height: 35px;
}

#DeckTitle {
  color: #ffffff;
  font-size: 21px;
  font-weight: normal;
}

#DeckNumBadge1, #DeckNumBadge2 {
  background-color: #111315;
  border-right: 1px solid #3b3f43;
}

#DeckNumBadge1 #DeckNumBadgeNum { color: #16aef0; }
#DeckNumBadge2 #DeckNumBadgeNum { color: #ff5b38; }

#DeckTrackTime, #DeckTrackTimeMini {
  color: #f4f6f7;
  font-family: "DejaVu Sans Mono";
  font-size: 30px;
}

#DeckHeaderBpmValue {
  color: #ff9a00;
  font-family: "DejaVu Sans Mono";
}

#DeckOverview {
  border-top: 1px solid #31353a;
  border-bottom: 1px solid #31353a;
  margin: 3px 0;
}

/* RX3 status / beat-fx strip ------------------------------------------- */
#RX3ModeStripStack, #RX3ModeStripPage, #RX3PadModeStack {
  background-color: #17191b;
}

#RX3StatusStrip {
  background-color: #202326;
  border-top: 1px solid #50545a;
  border-bottom: 1px solid #08090a;
  qproperty-layoutSpacing: 12;
  padding: 2px 8px 3px 8px;
}

#RX3StatusDeckWide {
  background-color: #111315;
  border-left: 1px solid #42464a;
  border-right: 1px solid #42464a;
  padding: 0 5px;
}

#RX3ModePage {
  background-color: #111315;
}

#RX3ModeTitle {
  color: #9aa0a6;
  font-size: 8px;
  font-weight: bold;
  qproperty-alignment: 'AlignCenter';
}

#RX3ModePadRow {
  qproperty-layoutSpacing: 4;
}

#RX3ModePad,
#RX3StatusHotcuePad {
  background-color: #151719;
  border: 1px solid #4b4f54;
  border-top: 2px solid #8f959a;
  color: #f2f3f4;
  font-size: 9px;
  font-weight: bold;
  margin: 0;
}

#RX3StatusHotcuePad[displayValue="1"],
#RX3StatusHotcuePad[displayValue="2"] {
  border: 2px solid #ffffff;
  color: #ffffff;
}

#RX3BeatStrip {
  padding: 2px 8px 4px 8px;
  qproperty-layoutSpacing: 8;
}

#RX3BeatFxBank, #RX3XPad {
  background-color: transparent;
}

#RX3BeatFxBankRow, #RX3XPadRow {
  qproperty-layoutSpacing: 4;
}

#RX3StripCaption, #RX3XPadLabel {
  border: 0;
  color: #92989d;
  padding: 0;
  qproperty-alignment: 'AlignCenter';
}

#RX3BankSlot,
WEffectSelector#RX3BankSlot,
#RX3BankDelete,
#RX3LoopButton {
  background-color: #111315;
  border: 1px solid #555a5f;
  color: #f3f4f5;
  font-size: 10px;
  font-weight: bold;
  margin: 0;
  min-height: 36px;
}

#RX3BankSlot[displayValue="1"], #RX3BankSlot[value="1"] {
  background-color: #d7dadd;
  color: #111315;
}

#RX3BankDelete {
  color: #8c9196;
  max-width: 34px;
}

#RX3BeatFxSelector,
WEffectSelector#RX3BeatFxSelector {
  background-color: #040506;
  border: 1px solid #454a4e;
  color: #ffffff;
  font-size: 14px;
  font-weight: bold;
}

#RX3BeatFxReadout {
  background-color: #020304;
  border: 1px solid #34383c;
  margin-top: 6px;
  padding: 8px 4px;
}

#RX3BeatFxBpmRow {
  qproperty-layoutAlignment: 'AlignCenter';
}

#RX3BeatFxBpm {
  color: #ffffff;
  font-family: "DejaVu Sans Mono";
  font-size: 27px;
  qproperty-alignment: 'AlignRight | AlignVCenter';
}

#RX3BeatFxBpmUnit {
  color: #bfc3c6;
  font-size: 8px;
  max-width: 28px;
  qproperty-alignment: 'AlignLeft | AlignBottom';
}

#RX3BeatFxBeat, #RX3BeatFxQuantize {
  color: #c8cccf;
  font-size: 9px;
  qproperty-alignment: 'AlignCenter';
}

/* RX3 browse ----------------------------------------------------------- */
#RX3LibraryPage, #RX3LibraryMain {
  background-color: #050607;
}

#RX3LibraryHeader {
  background-color: #17191b;
  border-top: 2px solid #00a6d5;
  border-bottom: 1px solid #34383c;
}

#RX3LibrarySource, #RX3LibraryBreadcrumb, #RX3LibraryInfo {
  color: #f0f2f3;
  font-size: 14px;
  padding: 0 10px;
  qproperty-alignment: 'AlignVCenter | AlignLeft';
}

#RX3LibraryInfo {
  qproperty-alignment: 'AlignCenter';
}

#RX3SearchToggle {
  background-color: #090a0b;
  border: 0;
  margin: 0;
  padding: 0;
}

#RX3SearchToggle:hover {
  background-color: #202020;
}

#RX3SearchExpanded {
  background-color: #090a0b;
  border: 0;
}

#RX3LibraryHeader #SearchBox {
  background-color: #090a0b;
  border: 0;
  border-bottom: 1px solid #00a6d5;
  color: #dfe2e4;
  font-size: 12px;
  font-weight: normal;
  padding: 3px 8px;
}

#SidebarWrapper {
  background-color: #181a1c;
  border-right: 2px solid #050607;
}

#RX3LibrarySidebarTitle {
  background-color: #303235;
  color: #aeb3b7;
  font-size: 9px;
  font-weight: bold;
  qproperty-alignment: 'AlignCenter';
}

#SidebarWrapper WLibrarySidebar {
  background-color: #181a1c;
  alternate-background-color: #202326;
  border: 0;
  color: #eef0f1;
  font-size: 11px;
  font-weight: normal;
  qproperty-indentation: 12;
  selection-background-color: #048ed2;
  selection-color: #ffffff;
}

#SidebarWrapper QScrollBar:horizontal {
  background-color: #101214;
  height: 8px;
}

#SidebarWrapper QScrollBar::handle:horizontal {
  background-color: #555a5e;
  min-width: 28px;
}

#SidebarWrapper QScrollBar::add-line:horizontal,
#SidebarWrapper QScrollBar::sub-line:horizontal {
  width: 0;
}

#LibraryWrapper WTrackTableViewHeader::section,
#LibraryWrapper QHeaderView::section {
  background-color: #303235;
  border: 0;
  border-right: 1px solid #151719;
  color: #b9bdc0;
  font-size: 10px;
  min-height: 32px;
  padding: 4px 8px;
}

#LibraryWrapper QTableView {
  background-color: #030405;
  alternate-background-color: #292b2d;
  border: 0;
  color: #f3f4f5;
  font-size: 13px;
  gridline-color: #111315;
  selection-background-color: #078fd2;
  selection-color: #ffffff;
}

#LibraryWrapper QTableView::item {
  border: 0;
  min-height: 34px;
  padding: 5px 7px;
}

#RX3LibraryDecks {
  background-color: #030405;
  border-top: 2px solid #00a6d5;
  qproperty-layoutSpacing: 12;
  padding: 3px 8px 5px 8px;
}

#RX3LibraryDeck {
  background-color: #08090a;
  border: 1px solid #33373a;
}

#RX3LibraryDeckHeader {
  background-color: #17191b;
  border-bottom: 1px solid #303438;
}

#RX3LibraryDeckNumber {
  background-color: #25282b;
  color: #dfe2e4;
  font-size: 9px;
  padding-left: 8px;
  qproperty-alignment: 'AlignVCenter | AlignLeft';
}

#RX3LibraryDeckTitle {
  color: #ffffff;
  font-size: 11px;
  padding-left: 8px;
}

#RX3LibraryDeckTime {
  color: #f3f4f5;
  font-family: "DejaVu Sans Mono";
  font-size: 17px;
  qproperty-alignment: 'AlignCenter';
}

#RX3LibraryDeckOverview {
  border-left: 1px solid #31353a;
  border-right: 1px solid #31353a;
}

#RX3LibraryDeckBpmCaption {
  color: #aeb2b6;
  font-size: 8px;
  qproperty-alignment: 'AlignCenter';
}

#RX3LibraryDeckBpm {
  color: #f3f4f5;
  font-family: "DejaVu Sans Mono";
  font-size: 19px;
  qproperty-alignment: 'AlignCenter';
}

/* RX3 reference-accurate performance geometry -------------------------
   These rules mirror the compact 16:9 hardware display: transport rail,
   two stacked waveform lanes, a shallow status strip and dense deck cards. */
#RX3Topbar {
  background-color: #111315;
  border-bottom: 1px solid #34383b;
  padding: 0 8px;
  qproperty-layoutSpacing: 8;
}

#RX3RemainBlock, #RX3TopbarStatus {
  qproperty-layoutAlignment: 'AlignVCenter';
}

#RX3ClockIcon {
  color: #747a80;
  font-size: 13px;
  max-width: 18px;
}

#RX3RemainLabel {
  color: #cdd1d4;
  font-size: 10px;
  letter-spacing: 1px;
  padding: 0 5px 0 0;
}

#RX3MasterTime {
  color: #dfe2e4;
  font-family: "DejaVu Sans Mono";
  font-size: 11px;
  min-width: 78px;
}

#RX3ProgressTrack {
  background-color: #202326;
  border: 1px solid #363a3e;
  qproperty-layoutAlignment: 'AlignVCenter';
  qproperty-layoutSpacing: 0;
}

#RX3ProgressPlayed { background-color: #777c80; }
#RX3ProgressHead { background-color: #dfe1e2; }
#RX3ProgressRemaining { background-color: #17191b; }

#RX3RecordDot {
  color: #ff4d1f;
  font-size: 9px;
  max-width: 15px;
  qproperty-alignment: 'AlignRight | AlignVCenter';
}

#RX3Clock {
  color: #b9bdc0;
  font-family: "DejaVu Sans Mono";
  font-size: 10px;
  min-width: 70px;
}

#RX3InfoLabel {
  background-color: #25282b;
  border: 1px solid #4b4f53;
  color: #d9dcde;
  font-size: 9px;
  font-weight: bold;
  max-width: 42px;
  qproperty-alignment: 'AlignCenter';
}

#RX3PerformanceArea { border-bottom: 1px solid #3b3f43; }

#WaveformInfo {
  background-color: #17191b;
  border: 1px solid #4a4e52;
  margin: 4px 5px 4px 6px;
}

#WaveformInfo_Header {
  background-color: #303337;
  border-bottom: 1px solid #60656a;
  border-radius: 0;
  padding: 0 6px;
}

#WaveformInfoSource { font-size: 13px; }
#WaveformInfo_Key_Container, #WaveformInfo_Jump_Container { padding: 0 6px; }
#WaveformInfoCaption { font-size: 8px; }
#WaveformInfo_Key, #WaveformInfoJump { font-size: 16px; }

#WaveformOnAirColumn1, #WaveformOnAirColumn2 {
  min-width: 42px;
  max-width: 42px;
}

#WaveformDeckNum1, #WaveformDeckNum2 { font-size: 25px; }

#SidePanel_Container {
  background-color: #17191b;
  border: 1px solid #3f4347;
  margin-left: 4px;
  padding: 5px;
}

#RX3BeatFxTitle { min-height: 25px; }
#RX3BeatFxSelector, WEffectSelector#RX3BeatFxSelector { font-size: 12px; }
#RX3BeatFxReadout { margin-top: 4px; padding: 5px 3px; }
#RX3BeatFxBpm { font-size: 24px; }
#RX3StatusTabs { margin-top: 4px; }

#RX3ModeStripStack, #RX3ModeStripPage, #RX3PadModeStack { min-height: 84px; max-height: 84px; }
#RX3StatusStrip { qproperty-layoutSpacing: 8; padding: 3px 6px 4px 6px; }
#RX3StatusDeckWide { padding: 0 4px; }
#RX3ModePadRow { qproperty-layoutSpacing: 3; }

#Decks {
  background-color: #020304;
  border-top: 2px solid #0d0f11;
  qproperty-layoutSpacing: 5;
}

#Deck {
  background-color: #080a0c;
  border: 1px solid #555a5e;
  border-top: 2px solid #09a4d1;
  margin: 0 3px 5px 3px;
}

#DeckHeader {
  background-color: #24272a;
  border-bottom: 1px solid #050607;
  min-height: 46px;
  max-height: 46px;
  padding: 0;
}

#DeckNumBadge1, #DeckNumBadge2 {
  background-color: #101214;
  border-right: 1px solid #4b4f53;
  min-width: 74px;
  max-width: 74px;
}

#DeckNumBadgeWord {
  color: #72808b;
  font-size: 8px;
  qproperty-alignment: 'AlignCenter | AlignBottom';
}

#DeckNumBadgeNum {
  font-size: 17px;
  qproperty-alignment: 'AlignCenter | AlignTop';
}

#DeckTitleNote { font-size: 17px; margin: 0 4px 0 8px; }
#DeckTitle { font-size: 18px; }

#DeckInfo, #DeckReadoutArea, #DeckReadoutRow { background-color: #090b0d; }

#TrackNoCol {
  background-color: #0b0d0f;
  border-right: 1px solid #303438;
  min-width: 74px;
  max-width: 74px;
  padding: 4px 5px 0 5px;
}

#TrackNoCaption {
  color: #8e979f;
  font-size: 8px;
  font-weight: bold;
  letter-spacing: 1px;
  qproperty-alignment: 'AlignLeft | AlignBottom';
}

#TrackNoValue {
  color: #f0f2f3;
  font-size: 13px;
  qproperty-alignment: 'AlignCenter';
}

#TrackNoQuantize {
  color: #f44336;
  font-size: 8px;
  font-weight: bold;
  letter-spacing: 1px;
  qproperty-alignment: 'AlignLeft | AlignTop';
}

#TrackNoQuantize[highlight="1"] { color: #ff4b37; }

#DeckCueCol {
  background-color: #07090a;
  padding: 4px 5px;
  qproperty-layoutSpacing: 2;
}

#DeckCueLabel {
  background-color: #090a0b;
  border: 1px solid #8b3729;
  color: #ff613d;
  font-size: 7px;
  font-weight: bold;
  min-width: 72px;
  qproperty-alignment: 'AlignCenter';
}

#DeckCueContinue {
  color: #abb0b4;
  font-size: 7px;
  qproperty-alignment: 'AlignCenter';
}

#TrackTimeContainer {
  background-color: #050607;
  padding: 3px 3px 0 5px;
}

#DeckTrackTimeTitle {
  margin: 0;
  min-height: 20px;
  max-height: 20px;
  padding: 0;
  qproperty-layoutSpacing: 5;
  qproperty-layoutAlignment: 'AlignLeft | AlignVCenter';
}

#TimeLabelRemain, #TimeLabelTime, #TimeLabelSlash {
  color: #5f788d;
  font-size: 8px;
  font-weight: bold;
}

#TimeLabelRemain[highlight="1"], #TimeLabelTime[highlight="1"] { color: #eef0f2; }

#DeckTrackTimeWrapper {
  margin: 0;
  padding: 0;
  qproperty-layoutAlignment: 'AlignLeft | AlignVCenter';
  qproperty-layoutSpacing: 0;
}

#DeckTrackTime, #DeckTrackTimeMini {
  color: #f5f6f7;
  font-family: "DejaVu Sans";
  font-size: 28px;
  font-weight: bold;
  margin: 0;
  min-width: 0px;
  padding: 0;
}

#DeckTempoPanel {
  background-color: #050607;
  padding: 3px 4px 0 4px;
}

#DeckTempoRow { qproperty-layoutAlignment: 'AlignCenter | AlignVCenter'; }

#DeckTempoCaption {
  color: #b8bec2;
  font-size: 7px;
  font-weight: bold;
}

#RateDisplay {
  color: #45e738;
  font-size: 11px;
  font-weight: bold;
  qproperty-alignment: 'AlignRight | AlignVCenter';
}

#DeckTempoPercentRow { qproperty-layoutAlignment: 'AlignRight | AlignVCenter'; }
#DeckTempoPercent, #BPMPercent { color: #e8eaeb; font-size: 16px; }

#DeckHeaderBpm {
  background-color: #050607;
  border: 2px solid #dfe1e2;
  border-radius: 0;
  margin: 2px 2px 3px 2px;
  padding: 1px 3px;
}

#DeckHeaderBpmTitle { color: #e8eaeb; font-size: 8px; }
#BpmMaster { color: #ff9b00; font-size: 7px; }

#DeckHeaderBpmValue {
  color: #ff9a00;
  font-family: "DejaVu Sans";
  font-size: 28px;
  font-weight: bold;
  qproperty-alignment: 'AlignRight | AlignVCenter';
}

#DeckOverviewContainer { margin: 0; padding: 0 3px 2px 3px; }
#DeckOverview {
  border-top: 1px solid #394047;
  border-bottom: 1px solid #394047;
  margin: 0;
}

/* RX3 0.5.0 — black hardware-display finish ---------------------------
   The RX3 uses colour as information, not as card decoration.  These final
   rules deliberately flatten the previous desktop-style panels. */
#RX3Topbar,
#RX3PerformanceArea,
#Waveform_Channel1,
#Waveform_Channel2,
#WaveformOnAirColumn1,
#WaveformOnAirColumn2,
#SidePanel_Container,
#RX3ModeStripStack,
#RX3ModeStripPage,
#RX3PadModeStack,
#RX3StatusStrip,
#RX3StatusDeckWide,
#RX3ModePage,
#Decks,
#Deck,
#DeckHeader,
#DeckNumBadge1,
#DeckNumBadge2,
#DeckInfo,
#DeckReadoutArea,
#DeckReadoutRow,
#TrackNoCol,
#DeckCueCol,
#TrackTimeContainer,
#DeckTempoPanel,
#DeckOverviewContainer {
  background-color: #000000;
  border: 0;
  border-radius: 0;
}

#RX3Topbar,
#RX3PerformanceArea,
#SidePanel_Container,
#RX3StatusStrip,
#RX3StatusDeckWide,
#Decks,
#Deck,
#DeckHeader,
#DeckNumBadge1,
#DeckNumBadge2,
#TrackNoCol,
#DeckOverview {
  border: 0;
}

#WaveformInfo {
  background-color: #000000;
  border: 0;
  margin: 4px 5px 4px 6px;
}

#WaveformInfoDeckTitle {
  background-color: #3c3e40;
  border: 0;
  color: #d9dcde;
  font-size: 8px;
  padding-left: 8px;
  qproperty-alignment: 'AlignLeft | AlignVCenter';
}

#WaveformInfo_Header {
  background-color: #303235;
  border: 0;
  padding: 0 6px;
}

#WaveformInfo_Key_Container,
#WaveformInfo_Jump_Container {
  background-color: #202224;
  border: 0;
  padding: 0 6px;
}

#WaveformInfo_Bars_Container { background-color: #000000; border: 0; }

#SidePanel_Container {
  margin-left: 4px;
  padding: 5px;
}

#RX3BeatFxTitle,
#RX3FxChannelLabel,
#RX3FxMaster,
#RX3StatusTab,
#RX3BeatFxTab {
  border: 0;
  border-radius: 0;
}

#RX3BeatFxTitle { background-color: #34373a; }
#RX3FxMaster { background-color: #181a1c; }
#RX3BeatFxReadout { background-color: #000000; border: 0; }
#RX3StatusTabs { border: 0; }

#RX3ModeStripStack,
#RX3ModeStripPage,
#RX3PadModeStack {
  min-height: 96px;
  max-height: 96px;
}

#RX3StatusStrip {
  qproperty-layoutSpacing: 8;
  padding: 3px 6px 8px 6px;
}

#RX3StatusDeckWide { padding: 0 4px; }
#RX3ModePadRow { qproperty-layoutSpacing: 4; }
#RX3ModeRowGap { background-color: #000000; min-height: 4px; max-height: 4px; }
#RX3HotcueBottomSpace { background-color: #000000; min-height: 8px; max-height: 8px; }

#RX3ModeTitle {
  background-color: #000000;
  border: 0;
  color: #aeb3b7;
}

#RX3StatusHotcuePad,
#RX3ModePad {
  border: 0;
  border-radius: 0;
  margin: 0;
}

#Decks { qproperty-layoutSpacing: 5; }

#Deck {
  border-top: 1px solid #126c94;
  margin: 0 3px 5px 3px;
}

#DeckHeader {
  min-height: 46px;
  max-height: 46px;
  padding: 0;
}

#DeckNumBadge1,
#DeckNumBadge2 {
  min-width: 74px;
  max-width: 74px;
}

#DeckNumBadgeWord,
#DeckNumBadgeNum,
#DeckNumBadge1 #DeckNumBadgeWord,
#DeckNumBadge1 #DeckNumBadgeNum,
#DeckNumBadge2 #DeckNumBadgeWord,
#DeckNumBadge2 #DeckNumBadgeNum {
  color: #ffffff;
}

#DeckTitle,
#DeckTitleNote { color: #ffffff; }

#TrackNoCol { padding: 4px 5px 0 5px; }
#DeckCueCol { padding: 4px 5px; }
#TrackTimeContainer { padding: 3px 3px 0 5px; }
#DeckTempoPanel { padding: 3px 4px 0 4px; }

/* BPM and cue outlines are controls shown on the RX3 itself, so they remain
   while all enclosing/card borders stay removed. */
#DeckHeaderBpm {
  background-color: #000000;
  border: 2px solid #dfe1e2;
  border-radius: 0;
}

#DeckOverview {
  background-color: #000000;
  margin: 0;
}

/* RX3 0.6.0 — sampled Pioneer display palette -------------------------
   Exact solids measured from the supplied Pioneer reference. */
#RX3Topbar,
#DeckHeader,
#DeckTitle,
#DeckTitleNote,
#WaveformInfo_Header,
#SidePanel_Container,
#RX3BeatStrip,
#RX3BankDelete,
#RX3LibraryDeckHeader {
  background-color: #202020;
}

#DeckNumBadge1,
#DeckNumBadge2,
#DeckNumBadgeNumberRow,
#WaveformInfo_Key_Container,
#WaveformInfo_Jump_Container,
#WaveformInfo_Bars_Container,
#RX3LibraryDeckNumber {
  background-color: #181818;
}

#WaveformInfoDeckTitle,
#RX3BeatFxTitle {
  background-color: #303030;
}

#DeckTitle,
#DeckTitleNote,
#DeckNumBadgeWord,
#DeckNumBadgeNum {
  color: #ffffff;
}

#DeckNumBadgeNumberRow {
  border: 0;
  qproperty-layoutSpacing: 0;
}

#DeckNumBadgeParen {
  background-color: #181818;
  border: 0;
  color: #F84418;
  font-size: 17px;
  qproperty-alignment: 'AlignCenter';
}

#RX3StatusTab[value="1"],
#RX3BankSlot[displayValue="1"],
#RX3BankSlot[value="1"],
#RX3LoopButton[value="1"] {
  background-color: #787C78;
  border-color: #787C78;
  color: #ffffff;
}

#RateDisplay {
  background-color: #F84418;
  border: 0;
  color: #000000;
  min-width: 38px;
  padding: 1px 4px;
  qproperty-alignment: 'AlignCenter';
}

#TrackNoQuantize,
#TrackNoQuantize[highlight="1"] {
  color: #F84418;
}

#DeckHeaderBpmValue {
  color: #ffffff;
}

#DeckHeaderBpm[highlight="1"] {
  border-color: #F97220;
}

#DeckHeaderBpmValue[highlight="1"],
#BpmMaster {
  color: #F97220;
}

/* RX3 0.8.0 — BROWSE transport and compact deck overviews ------------- */
#RX3ProgressTrack {
  background-color: #34383b;
  border: 0;
  max-height: 6px;
  min-height: 6px;
  padding: 0;
}

#RX3ProgressMeter {
  background-color: #34383b;
  border: 0;
  min-height: 6px;
  max-height: 6px;
}

#RX3BrowseRemainBlock {
  background-color: #202020;
  border: 0;
  qproperty-layoutAlignment: 'AlignRight | AlignVCenter';
  qproperty-layoutSpacing: 3;
}

#RX3BrowseClockIcon {
  color: #8b9195;
  font-size: 14px;
  min-width: 18px;
  max-width: 18px;
  padding: 0;
  qproperty-alignment: 'AlignCenter';
}

#RX3BrowseMasterTime {
  color: #d9dde0;
  font-family: "DejaVu Sans Mono";
  font-size: 11px;
  min-width: 78px;
  qproperty-alignment: 'AlignLeft | AlignVCenter';
}

#RX3LibraryDecks {
  background-color: #000000;
  border-top: 2px solid #00a6d5;
  padding: 3px 8px 5px 8px;
  qproperty-layoutSpacing: 12;
}

#RX3LibraryDeck {
  background-color: #000000;
  border: 0;
}

#RX3LibraryDeckHeader {
  background-color: #202020;
  border: 0;
}

#RX3LibraryDeckNumber {
  background-color: #181818;
  color: #ffffff;
  font-size: 9px;
  padding: 0 8px;
  qproperty-alignment: 'AlignCenter';
}

#RX3LibraryDeckTitle {
  background-color: #202020;
  color: #dfe2e4;
  border: 0;
  font-size: 10px;
  padding-left: 7px;
}

#RX3LibraryDeckBody,
#RX3LibraryDeckTimeBox {
  background-color: #000000;
  border: 0;
}

#RX3LibraryDeckTimeBox {
  min-width: 110px;
  max-width: 110px;
}

#RX3LibraryDeckTimeCaption,
#RX3LibraryDeckBpmCaption {
  color: #aeb2b6;
  font-size: 8px;
  padding: 1px 0 0 7px;
  qproperty-alignment: 'AlignLeft | AlignVCenter';
}

#RX3LibraryDeckTime {
  color: #f3f4f5;
  font-family: "DejaVu Sans Mono";
  font-size: 18px;
  padding-right: 7px;
  qproperty-alignment: 'AlignRight | AlignVCenter';
}

#RX3LibraryDeckOverview {
  background-color: #000000;
  border: 0;
  min-width: 240px;
}

#RX3LibraryDeckBpmBox1,
#RX3LibraryDeckBpmBox2 {
  background-color: #000000;
  border: 1px solid #e4e6e7;
  margin: 3px 3px 3px 6px;
  min-width: 88px;
  max-width: 88px;
}

#RX3LibraryDeckBpm1,
#RX3LibraryDeckBpm2 {
  background-color: #000000;
  color: #ffffff;
  font-family: "DejaVu Sans Mono";
  font-size: 20px;
  qproperty-alignment: 'AlignCenter';
}

#RX3LibraryDeckBpmBox1 {
  border-color: #F97220;
}

#RX3LibraryDeckBpm1 {
  color: #F97220;
}

/* RX3 0.12 — 1280 × 800 reference canvas. Keep this geometry together.
   Measurements refer to the display content, excluding the OS title bar. */
#SkinContainer { padding: 8px 10px 10px 10px; }
#RX3Topbar { background: #000; padding: 0; border: 0; qproperty-layoutSpacing: 8; }
#RX3RemainBlock { background: #202020; qproperty-layoutSpacing: 6; }
#RX3ClockIcon { min-width: 18px; max-width: 18px; font-size: 18px; }
#RX3RemainLabel { font-size: 13px; font-weight: normal; letter-spacing: 0; padding: 0; }
#RX3MasterTime { min-width: 78px; font-family: "Arial"; font-size: 13px; }
#RX3ProgressTrack, #RX3ProgressMeter { min-height: 4px; max-height: 4px; background: #181818; }
#RX3TopbarStatus { background: #000; qproperty-layoutSpacing: 6; }
#RX3RecordDot { font-size: 12px; }
#RX3Clock { font-family: "Arial"; font-size: 13px; }
#RX3InfoLabel { background: #000; border: 0; font-size: 17px; font-weight: normal; min-width: 76px; max-width: 76px; }
#RX3PerformanceArea { border: 0; qproperty-layoutSpacing: 0; }
#RX3WaveformRightGap { background: #000; border: 0; margin: 0; padding: 0; }
#WaveformsContent { qproperty-layoutSpacing: 0; }
#WaveformDeckInfo, #WaveformSignalContent { qproperty-layoutSpacing: 18; }
#WaveformInfo { background: #181818; margin: 0 8px 0 0; border: 1px solid #343434; }
#WaveformInfoDeckTitle { background: #303030; color: #b8b8b8; font-size: 14px; font-weight: normal; padding-left: 17px; border-bottom: 2px solid #007da7; }
#WaveformInfo_Header { background: #202020; border-bottom: 1px solid #383838; padding: 0 16px; qproperty-layoutAlignment: 'AlignLeft | AlignVCenter'; qproperty-layoutSpacing: 8; }
#WaveformInfoSource { font-size: 22px; font-weight: normal; qproperty-alignment: 'AlignLeft | AlignVCenter'; }
#SidebarEject { color: #b9b9b9; border: 0; }
#WaveformInfo_Data_Container { qproperty-layoutAlignment: 'AlignTop'; }
#WaveformInfo_Key_Container, #WaveformInfo_Jump_Container { padding: 0 16px; border-bottom: 1px solid #383838; qproperty-layoutAlignment: 'AlignLeft | AlignVCenter'; qproperty-layoutSpacing: 6; }
#WaveformInfoCaption { color: #bcbcbc; font-size: 16px; font-weight: normal; min-width: 22px; max-width: 22px; qproperty-alignment: 'AlignLeft | AlignVCenter'; }
#WaveformInfo_Key, #WaveformInfoJump { font-size: 23px; font-weight: normal; color: #eeeeee; qproperty-alignment: 'AlignLeft | AlignVCenter'; }
#WaveformInfo_Jump_Container #WaveformInfoCaption, #WaveformInfoJump { color: #ff7800; }
#SidePanel_Container { background: #000; margin: 0; padding: 0; border: 0; qproperty-layoutAlignment: 'AlignJustify'; }
#SidePanelBody { qproperty-layoutAlignment: 'AlignJustify'; qproperty-layoutSpacing: 0; }
#RX3FxBezel { background: #202020; padding: 0 9px 10px 9px; qproperty-layoutSpacing: 8; }
#RX3BeatFxTitle { background: #303030; min-height: 28px; max-height: 28px; font-size: 14px; font-weight: normal; }
#RX3BeatFxSelector, WEffectSelector#RX3BeatFxSelector { background: #000; border: 0; font-size: 22px; font-weight: normal; padding-left: 5px; }
#RX3BeatFxSelector::drop-down { border: 0; width: 12px; }
#RX3BeatFxCaption { min-height: 18px; max-height: 18px; font-size: 12px; qproperty-alignment: 'AlignCenter'; }
#RX3FxMaster { background: #000; color: #eee; font-size: 21px; font-weight: normal; border: 0; }
#RX3FxMaster[value="1"] { background: #0084df; border: 0; }
#RX3BeatFxReadout { background: #000; margin: 0; padding: 6px 4px; qproperty-layoutSpacing: 8; qproperty-layoutAlignment: 'AlignTop'; }
#RX3BeatFxBpmRow { qproperty-layoutAlignment: 'AlignHCenter | AlignBottom'; }
#RX3BeatFxBpm { font-family: "Arial"; font-size: 30px; font-weight: normal; }
#RX3BeatFxBpmUnit { font-size: 9px; }
#RX3BeatFxBeat { font-size: 17px; font-weight: normal; qproperty-alignment: 'AlignRight | AlignVCenter'; padding-right: 17px; }
#RX3BeatFxQuantize { font-size: 12px; font-weight: normal; border-top: 1px solid #111; padding-top: 5px; }
#RX3FxSpacer { min-height: 8px; }
#RX3ZoomControls { background: #000; qproperty-layoutSpacing: 5; }
#RX3ZoomControls WPushButton { margin: 0; padding: 0; min-height: 28px; max-height: 28px; font-size: 13px; font-weight: normal; border-radius: 0; }
#RX3ZoomControls #ZoomOutButton { min-width: 18px; max-width: 18px; border: 0; color: #7c7c7c; }
#RX3ZoomControls #ZoomInButton { border: 1px solid #0098f6; color: #0098f6; }
#RX3ZoomControls #GridButton { border: 0; color: #888; }
#RX3StatusTabs { background: #000; border: 1px solid #777; margin: 8px 0 0 0; padding: 2px; qproperty-layoutSpacing: 0; }
#RX3StatusTab { min-width: 0; background: #000; font-size: 17px; font-weight: normal; color: #888; border: 0; }
#RX3StatusTab[value="1"] { background: #9b9e99; color: #101010; border: 0; }
#RX3ModeStripStack, #RX3ModeStripPage { min-height: 80px; max-height: 80px; }
#RX3PadModeStack { min-height: 70px; max-height: 70px; }
#RX3StatusStrip { padding: 2px 0 6px 0; qproperty-layoutSpacing: 18; }
#RX3StatusDeckWide { padding: 0; }
#RX3ModePage { qproperty-layoutAlignment: 'AlignTop'; }
#RX3ModeTitle { font-size: 11px; font-weight: normal; color: #8a8a8a; border-top: 1px solid #222; }
#RX3ModePadRow { qproperty-layoutSpacing: 6; }
#RX3ModeRowGap { min-height: 5px; max-height: 5px; }
#RX3HotcueBottomSpace { min-height: 4px; max-height: 4px; }
#RX3HotcueSlot { background: #282828; qproperty-layoutAlignment: 'AlignCenter'; }
#RX3StatusHotcuePad { min-width: 16px; max-width: 16px; min-height: 16px; max-height: 16px; font-size: 12px; font-weight: normal; color: #888; border: 0; padding: 0; }
#RX3StatusHotcuePad[displayValue="1"], #RX3StatusHotcuePad[displayValue="2"] { border: 0; color: #111; }
#RX3StatusHotcuePad[dark="true"] { color: #fff; }
#RX3ModePad { background: #282828; font-size: 12px; font-weight: normal; border: 0; }
#RX3BeatStrip { background: #202020; padding: 0 8px 10px 8px; qproperty-layoutSpacing: 12; border-top: 1px solid #444; border-bottom: 1px solid #444; }
#RX3BeatFxBankRow { qproperty-layoutSpacing: 8; }
#RX3XPadRow { qproperty-layoutSpacing: 0; }
#RX3StripCaption, #RX3XPadLabel { font-size: 12px; font-weight: normal; }
#RX3BankSlot, WEffectSelector#RX3BankSlot, #RX3LoopButton { background: #202020; min-height: 38px; max-height: 40px; border: 1px solid #626262; font-size: 18px; font-weight: normal; padding: 0 3px; }
#RX3BankSlot::drop-down { width: 10px; border: 0; }
#RX3BankDelete { background: #202020; border: 0; font-size: 20px; font-weight: normal; }
#RX3LoopButton[value="1"], #RX3BankSlot[value="1"] { background: #787c78; color: #fff; }
#Decks { qproperty-layoutSpacing: 18; padding-top: 6px; }
#Deck { border: 1px solid transparent; border-top: 2px solid #027da7; margin: 0; }
#DeckHeader { background: #202020; min-height: 52px; max-height: 52px; }
#DeckNumBadge1, #DeckNumBadge2, #TrackNoCol { min-width: 92px; max-width: 92px; }
#DeckNumBadgeWord { font-size: 12px; font-weight: normal; letter-spacing: 0; }
#DeckNumBadgeNum { font-size: 26px; font-weight: normal; }
#DeckNumBadgeParen { font-size: 22px; }
#DeckTitleNote { font-size: 24px; margin: 0 3px 0 10px; }
#DeckTitle { font-size: 23px; font-weight: normal; }
#TrackNoCol { padding: 10px 0 0 0; qproperty-layoutAlignment: 'AlignTop'; qproperty-layoutSpacing: 4; }
#TrackNoCaption { font-size: 12px; font-weight: normal; letter-spacing: 0; color: #ddd; qproperty-alignment: 'AlignCenter'; }
#TrackNoValue { font-size: 27px; font-weight: normal; min-height: 30px; qproperty-alignment: 'AlignCenter'; }
#TrackNoPlayMode { font-size: 11px; color: #ddd; min-height: 17px; qproperty-alignment: 'AlignCenter'; }
#TrackNoQuantize { font-size: 11px; font-weight: normal; letter-spacing: 0; min-height: 18px; qproperty-alignment: 'AlignCenter'; }
#DeckReadoutRow { min-height: 82px; max-height: 82px; }
#DeckCueCol { padding: 12px 0 8px 0; qproperty-layoutSpacing: 10; qproperty-layoutAlignment: 'AlignTop'; }
#DeckCueLabel, #DeckAutoCueLabel { font-size: 11px; font-weight: normal; min-width: 78px; max-width: 78px; min-height: 18px; max-height: 18px; border: 1px solid #f75c00; color: #f75c00; background: #000; qproperty-alignment: 'AlignCenter'; }
#DeckAutoCueLabel { border-color: #bbb; color: #ddd; }
#TrackTimeContainer { padding: 8px 2px 0 6px; }
#DeckTrackTimeTitle { min-height: 18px; max-height: 18px; qproperty-layoutSpacing: 3; }
#TimeLabelRemain, #TimeLabelTime, #TimeLabelSlash { color: #777; font-size: 11px; font-weight: normal; }
#DeckTrackTimeWrapper { qproperty-layoutAlignment: 'AlignLeft | AlignTop'; }
#DeckTrackTime { font-family: "Arial"; font-size: 39px; font-weight: normal; padding: 0; margin: 0; }
#DeckTempoPanel { padding: 8px 4px 0 2px; }
#DeckTempoCaption { font-size: 10px; font-weight: normal; }
#RateDisplay { font-size: 13px; min-width: 36px; padding: 1px 2px; }
#DeckTempoPercent, #BPMPercent { font-family: "Arial"; font-size: 25px; font-weight: normal; }
#DeckHeaderBpm { border: 1px solid #ddd; margin: 10px 6px 8px 3px; padding: 0 3px; }
#DeckHeaderBpmTitle { font-size: 11px; font-weight: normal; }
#DeckHeaderBpmTitleRow { min-height: 16px; max-height: 16px; }
#BpmMaster { background: #f97220; color: #000; font-size: 10px; font-weight: normal; }
#DeckHeaderBpmValue { font-family: "Arial"; font-size: 34px; font-weight: normal; }
#DeckOverviewContainer { padding: 0 8px 6px 0; margin: 0; }
#DeckOverview { border-bottom: 0; }

#TrackTimeContainer { min-width: 186px; max-width: 220px; }
#DeckTrackTimeWrapper { min-width: 180px; }
#RX3ZoomControls { qproperty-layoutAlignment: 'AlignCenter'; }

#WaveformInfo_Bars_Container { padding: 0 16px; border-bottom: 1px solid #383838; qproperty-layoutAlignment: 'AlignLeft | AlignVCenter'; }
#WaveformInfo_Bars { color: #888; font-size: 20px; font-weight: normal; text-transform: none; }
#RateRangeBadge, #RateRangeSuffix { background: #f84418; color: #000; font-size: 13px; }
#RateDisplay { min-width: 0; padding: 0; }
#TrackNoQuantizeValue { color: #f84418; font-size: 27px; font-weight: normal; qproperty-alignment: 'AlignCenter'; }

/* Native RX3 readouts and full-width hotcue hit targets (0.12). */
#RX3StatusHotcuePad { min-width: 0; max-width: 16777215px; min-height: 18px; max-height: 18px; font-size: 12px; }
#RX3BeatFxMilliseconds { color: #eee; font-family: "Arial"; font-size: 23px; font-weight: normal; qproperty-alignment: 'AlignRight | AlignVCenter'; padding-right: 12px; }
#WaveformInfo_Bars { font-size: 23px; color: #ff7800; font-weight: normal; }
#RX3BeatFxReadout { qproperty-layoutSpacing: 4; }
#DeckTrackTime { font-size: 47px; }

/* RX3 0.13: exclusive playback master and fixed readout slots. */
#TrackNoCaption { min-height: 16px; max-height: 16px; }
#TrackNoValue { min-height: 30px; max-height: 30px; }
#TrackNoPlayMode { min-height: 17px; max-height: 17px; }
#TrackNoQuantize { min-height: 18px; max-height: 18px; color: transparent; }
#TrackNoQuantizeValue { min-height: 30px; max-height: 30px; color: transparent; }
#TrackNoQuantize[highlight="1"], #TrackNoQuantizeValue[highlight="1"] { color: #ff7800; }
#DeckHeaderBpm { min-width: 104px; max-width: 104px; border-color: #ddd; padding: 0; }
#DeckHeaderBpm[highlight="1"] { border-color: #ff7800; }
#DeckHeaderBpmTitleRow { min-height: 16px; max-height: 16px; qproperty-layoutSpacing: 0; }
#DeckHeaderBpmTitle { min-width: 28px; max-width: 28px; font-size: 11px; color: #eee; padding: 0 1px; qproperty-alignment: 'AlignLeft | AlignVCenter'; }
#BpmMaster { min-width: 58px; max-width: 16777215px; padding: 0; font-size: 11px; color: transparent; background: transparent; qproperty-alignment: 'AlignCenter'; }
#BpmMaster[highlight="1"] { color: #000; background: #ff7800; }
#DeckHeaderBpmValue { color: #fff; }
#DeckHeaderBpmValue[highlight="1"] { color: #ff7800; }
#WaveformInfo_Bars, #WaveformInfoJump, #WaveformInfo_Jump_Container #WaveformInfoCaption { color: #eee; }
#WaveformInfo_Bars[highlight="1"], #WaveformInfoJump[highlight="1"], #WaveformInfo_Jump_Container #WaveformInfoCaption[highlight="1"] { color: #ff7800; }
#RX3StatusTabs { margin: 0; padding: 2px; min-height: 50px; max-height: 50px; border: 1px solid #777; }
#RX3StatusTabs #RX3StatusTab { min-height: 44px; max-height: 44px; margin: 0; padding: 0; }
#RX3FxSpacer { min-height: 14px; max-height: 16777215px; }
#RX3ZoomControls { min-height: 36px; max-height: 36px; }
#RX3TopbarWrapper { qproperty-layoutAlignment: 'AlignTop'; }
#RX3ModeStripContainer { padding-top: 10px; }
#RX3LibraryDeckBpmBox1, #RX3LibraryDeckBpmBox2 { border-color: #ddd; }
#RX3LibraryDeckBpm1, #RX3LibraryDeckBpm2 { color: #fff; }
#RX3LibraryDeckBpmBox1[highlight="1"], #RX3LibraryDeckBpmBox2[highlight="1"] { border-color: #ff7800; }
#RX3LibraryDeckBpm1[highlight="1"], #RX3LibraryDeckBpm2[highlight="1"] { color: #ff7800; }

#RX3TransportRail { background: #202020; qproperty-layoutSpacing: 12; padding: 0 8px; }
#RX3RemainBlock { background: transparent; }
#RX3Topbar { qproperty-layoutAlignment: 'AlignLeft | AlignVCenter'; }
#WaveformInfo { border: 0; margin: 0 8px 0 0; }
#WaveformInfoDeckTitle { font-size: 13px; padding-left: 16px; }
#WaveformInfo_Header { padding: 0 16px; qproperty-layoutSpacing: 5; }
#WaveformInfoSource { font-size: 20px; }
#WaveformInfoUsbIcon { min-width: 16px; max-width: 16px; }
#WaveformInfo_Key_Container { padding: 0 16px; qproperty-layoutSpacing: 5; }
#WaveformInfoCaption { font-size: 11px; min-width: 20px; max-width: 20px; }
#WaveformInfo_Key { font-size: 20px; }

/* Native RX3 browser: reference table, category rail and SOURCE page. */
#RX3NativeBrowser, #RX3BrowserTracks, #RX3BrowserCategories, #RX3BrowserFolders { background: #000; color: #fff; border: 0; }
#RX3BrowserHeader { background: #191919; border: 0; }
#RX3BrowserHeader QLabel { font-family: "Arial Narrow"; font-size: 21px; color: #fff; background: transparent; }
#RX3BrowserHeader QPushButton { color: #ddd; background: #202020; border: 0; padding: 8px; font-size: 14px; }
#RX3BrowserHeader QPushButton[active="true"] { border-top: 2px solid #008baa; color: #fff; }
#RX3BrowserHeader QPushButton[encoderFocus="true"] { border: 1px solid white; color: #fff; }
#RX3BrowserHeader QPushButton:disabled { color: #777; }
#RX3BrowserHeader QLineEdit { background: #303030; border: 1px solid #007CE0; color: #fff; font-size: 18px; }
#RX3BrowserCategories { font-family: "Arial"; font-size: 12px; outline: 0; }
#RX3BrowserCategories::item { background: #202020; color: #fff; border: 0; padding: 0; }
#RX3BrowserCategories::item:selected { background: #007CE0; border-left: 4px solid #fff; }
#RX3BrowserFolders { alternate-background-color: #262626; font-family: "Arial Narrow"; font-size: 20px; outline: 0; }
#RX3BrowserFolders::item { height: 43px; padding: 0 7px; }
#RX3BrowserFolders::item:selected { background: #007CE0; color: #fff; }
#RX3PlaylistPreview { background: #000; color: #fff; }
#RX3PlaylistPreviewHeader { background: #191919; color: #fff; border-bottom: 1px solid #008baa; font-family: "Arial Narrow"; font-size: 20px; padding-left: 14px; }
#RX3PlaylistPreviewTracks { background: #000; alternate-background-color: #262626; color: #fff; border: 0; font-family: "Arial"; font-size: 18px; }
#RX3PlaylistPreviewTracks::item { border: 0; padding: 0 10px; }
#RX3PlaylistPreviewTracks QHeaderView::section { background: #303030; color: #b7b7b7; border: 0; border-right: 1px solid #101010; font-family: "Arial"; font-size: 15px; padding-left: 10px; }
#RX3PlaylistPreviewMessage { background: #000; color: #aab2b8; font-family: "Arial"; font-size: 18px; }
#RX3BrowserTracks QTableView { background: #000; alternate-background-color: #262626; selection-background-color: #007CE0; selection-color: #fff; border: 0; padding: 0; gridline-color: #000; }
#RX3BrowserTracks QTableView::item { border: 0; padding: 0; }
#RX3BrowserSources { background: #1b2026; color: #fff; border: 0; font-family: "Arial Narrow"; font-size: 26px; }
#RX3BrowserSources::item { height: 84px; padding-left: 16px; }
#RX3BrowserSources::item:selected { background: #007CE0; color: #fff; }
#RX3BrowserSources QHeaderView::section { background: #30343b; color: #bbb; border: 0; font-size: 16px; padding: 12px; }
#RX3SourceInfo { background: #20252b; color: #ddd; font-size: 19px; padding: 18px; }
#RX3NativeBrowser QScrollBar:vertical { width: 4px; background: #000; }
#RX3NativeBrowser QScrollBar::handle:vertical { background: #888; min-height: 24px; }
#RX3NativeBrowser QScrollBar::add-line, #RX3NativeBrowser QScrollBar::sub-line { height: 0; }

#WaveformInfoUsbIcon { image: url(skin:/icons/rx3-usb.svg); min-height: 22px; max-height: 22px; }
#WaveformInfo_Key { text-transform: none; }
#RX3BrowseColumnHeader { background: #303030; color: #b7b7b7; font-family: "Arial"; font-size: 15px; padding-left: 10px; }

#RX3BrowserFacets { background: #000; color: #fff; font-size: 20px; border: 0; }
#RX3BrowserFacets::item { padding: 0 8px; border: 0; }
#RX3BrowserFacets::item:selected { background: #007CE0; }

#RX3TrackInfo { background: #202020; color: #fff; font-size: 17px; padding: 14px; }
#RX3LibraryDeckNumber { min-width: 92px; max-width: 92px; }
#RX3LibraryDeckHeader, #RX3LibraryDeckTitle { background: #000; }

/* RX3 0.16: compact browser decks with a full-height overview. */
#RX3LibraryDeck { border-top: 1px solid #008baa; }
#RX3LibraryDeckTimeBox { min-width: 100px; max-width: 100px; }
#RX3LibraryDeckNumber { font-size: 12px; padding: 0; }
#RX3LibraryDeckTimeCaption { font-size: 11px; padding: 0 5px; }
#RX3LibraryDeckTime { font-family: "Arial"; font-size: 28px; padding: 0 5px; qproperty-alignment: 'AlignLeft | AlignVCenter'; }
#RX3LibraryDeckBpmBox1, #RX3LibraryDeckBpmBox2 { min-height: 60px; max-height: 60px; margin: 8px 3px 8px 6px; }
#RX3LibraryDeckBpm1, #RX3LibraryDeckBpm2 { font-size: 32px; }

#RX3LibraryBpmHeader { qproperty-layoutSpacing: 0; }
#RX3LibraryDeckBpmCaption { min-width: 27px; max-width: 27px; padding: 0 1px; qproperty-alignment: 'AlignLeft | AlignVCenter'; }
#RX3LibraryMaster { color: transparent; background: transparent; font-size: 10px; padding: 0; qproperty-alignment: 'AlignCenter'; }
#RX3LibraryMaster[highlight="1"] { color: #000; background: #ff7800; }

#RX3LibraryDecks { border: 0; }

/* v1.8: one painted badge keeps DECK, numeral and animated waves aligned. */
#DeckNumBadge1, #DeckNumBadge2 { margin: 0; padding: 0; border: 0; min-height: 52px; max-height: 52px; background: #181818; }

/* 1.9: touch search and paired USB browse columns. */
#RX3SearchKeyboard { background: #202020; }
#RX3SearchKeyboard QPushButton { color: #fff; background: #303030; border: 1px solid #aaa; font-size: 24px; }
#RX3SearchKeyboard QPushButton:pressed { background: #007CE0; }
#RX3BrowserFacets { alternate-background-color: #262626; }
#RX3SourceInfo { background: #202020; padding: 0; }

#RX3BrowserBreadcrumb { font-family: "Arial Narrow"; font-size: 21px; color: #fff; background: transparent; text-align: left; padding: 0; }
#RX3BrowserHeader QPushButton#RX3BrowserBreadcrumb { padding: 0 12px; background: #303030; font-size: 18px; }

#RX3SourceInfoPanel { background: #202020; }
#RX3SourceSettings { color: #fff; background: transparent; border: 1px solid #aaa; font-size: 20px; min-height: 46px; }
#RX3SourceSettings:disabled { color: #777; border-color: #555; }
#RX3SourceSettings:pressed { background: #007CE0; }
#RX3SourceSettings[encoderFocus="true"] { border: 1px solid white; background: #007CE0; }

/* v1.9 performance refinements: selected deck, GRID, pads and readouts. */
#RX3ModeTitle { border: 0; padding: 0; margin: 0; font-size: 10px; font-weight: bold; qproperty-alignment: 'AlignCenter'; }
#RX3JumpPad { background: #252525; border: 0; padding: 0; margin: 0; color: #fff; font-size: 13px; font-weight: bold; }
#RX3JumpPad:pressed { background: #007CE0; }
#RX3GridTools { background: #000; qproperty-layoutSpacing: 5; }
#RX3GridTool { background: #252525; border: 0; padding: 2px; font-size: 11px; font-weight: bold; color: #eee; }
#RX3GridTool:pressed { background: #007CE0; }
#RX3GridTool[highlight="1"] { background: #000; color: #bbb; }
#Deck, #RX3LibraryDeck { border: 1px solid transparent; }
#Deck[highlight="1"], #RX3LibraryDeck[highlight="1"] { border: 1px solid #eee; }
#WaveformInfo { border: 1px solid transparent; }
#WaveformInfo[highlight="1"] { border: 1px solid #eee; }
#RX3StatusTabs { min-height: 40px; max-height: 40px; border: 2px solid #777; padding: 0; margin: 0; }
#RX3StatusTabs #RX3StatusTab { min-height: 32px; max-height: 32px; padding: 0; margin: 2px; font-size: 16px; }
#DeckHeaderBpm { min-width: 88px; max-width: 88px; }
#DeckHeaderBpmTitleRow { min-height: 14px; max-height: 14px; }
#DeckHeaderBpmTitle { min-width: 28px; max-width: 28px; font-size: 10px; }
#BpmMaster { min-width: 0; font-size: 10px; font-weight: bold; }
#DeckTempoPanel { min-width: 114px; max-width: 114px; padding: 8px 6px 0 0; }
#DeckTempoRow { qproperty-layoutSpacing: 8; }
#DeckTempoCaption { min-width: 36px; }
#RateRangeBadge { background: #f84418; }
#RateRangeBadge[highlight="1"] { background: #18fc00; }
#RateDisplay, #RateRangeSuffix { background: transparent; color: #000; }
#DeckTrackTime, #DeckTrackTimeMini, #DeckTempoPercent, #BPMPercent,
#DeckHeaderBpmValue, #RateDisplay, #RateRangeSuffix, #TrackNoValue,
#TrackNoQuantizeValue, #RX3LibraryDeckTime, #RX3LibraryDeckBpm1, #RX3LibraryDeckBpm2,
#WaveformInfo_Bars, #WaveformInfoJump, #RX3BeatFxBpm, #RX3BeatFxMilliseconds,
#RX3BeatFxBeat, #RX3ModePad, #RX3BeatLengthButton, #TopStatusClock { font-weight: normal; }
#RX3StatusHotcuePad { font-weight: normal; }

WNumber, WNumberPos, WNumberBpm, WNumberRate, WRateRange, WTime { font-weight: normal; }
#RX3LoopButton, #WaveformInfoDeckTitle, #RX3LibraryDeckNumber { font-weight: normal; }

/* 1.9.1: reference typography and exact accent colors. */
#DeckCueLabel { border-color: #BF3413; color: #BF3413; }
#RateRangeBadge { background: #F84418; }
#RateRangeBadge[highlight="1"] { background: #18FC00; }
#BpmMaster { font-weight: normal; }
#BpmMaster[highlight="1"] { background: #F87020; color: #000; }
#DeckHeaderBpm[highlight="1"] { border-color: #F87020; }
#DeckHeaderBpmValue[highlight="1"] { color: #F87020; }

#TrackNoQuantize[highlight="1"], #TrackNoQuantizeValue[highlight="1"] { color: #BF3413; }

/* Thin numeric faces match the supplied deck reference, including rich readouts. */
#DeckTrackTime, #DeckTrackTimeMini, #DeckTempoPercent, #BPMPercent,
#DeckHeaderBpmValue, #RateDisplay, #RateRangeSuffix,
#RX3LibraryDeckTime, #RX3LibraryDeckBpm1, #RX3LibraryDeckBpm2 {
  font-family: "Helvetica Neue", "Segoe UI", "Arial";
  font-weight: 300;
}

/* GRID and ZOOM are mutually exclusive; displayValue follows the real mode. */
#RX3ZoomControls #ZoomInButton { color: #0098f6; background: #08090a; border: 1px solid #0098f6; }
#RX3ZoomControls #ZoomInButton[displayValue="1"] { color: #888; border-color: transparent; }
#RX3ZoomControls #GridButton { color: #888; background: #08090a; border: 1px solid transparent; }
#RX3ZoomControls #GridButton[displayValue="1"] { color: #0098f6; border-color: #0098f6; }
#RX3GridToolRow { background: #000; qproperty-layoutSpacing: 4; }

/* Keep every STATUS pad page on the same title and button baselines. */
#RX3ModePage, #RX3GridTools {
  min-height: 70px; max-height: 70px;
  padding: 0; margin: 0; border: 0;
  qproperty-layoutSpacing: 0;
  qproperty-layoutAlignment: 'AlignTop';
}
#RX3GridTool { padding: 0; margin: 0; }
#RX3ModeTitleGap { background: #000; min-height: 8px; max-height: 8px; }
#RX3ModeRowGap { min-height: 10px; max-height: 10px; }

/* v2.0: RX3 range colors; WIDE is red text on the deck background. */
#RateRangeBadge[highlight="2"] { background: #ffffff; }
#RateRangeBadge[highlight="3"] { background: transparent; }

/* v2.0: title rail and readout baselines from the RX3 reference. */
#DeckHeader { border: 0; border-top: 2px solid #00839E; }
#DeckTempoPanel { padding: 8px 6px 0 0; }
#DeckTempoRow { qproperty-layoutAlignment: 'AlignCenter | AlignTop'; }
#DeckHeaderBpm { margin: 4px 6px 12px 3px; }
#RX3BrowserTracks QTableView, #RX3PlaylistPreviewTracks {
    selection-background-color: #007CE0; selection-color: #fff;
}

/* Four persistent Beat FX favorites and momentary, continuous X-PAD. */
QPushButton[rx3Bank="true"] {
  background: #202020; color: #fff; border: 1px solid #626262;
  font-size: 16px; font-weight: normal; padding: 0 3px;
}
QMenu#RX3BankEffectMenu { font-size: 16px; }
QPushButton[rx3Bank="true"][selected="true"] { background: #787c78; border: 1px solid #fff; }
QPushButton[rx3Bank="true"][empty="true"] { background: #000000; }
QPushButton[rx3Bank="true"]:disabled { color: #777; }
#RX3BankDelete:checked { color: #ff4b20; }
/* Native X-PAD paints the RX3 rail/arrows and momentary cyan highlight. */
#RX3XPadSlider { background: transparent; border: 0; }

/* Beat FX side panel: dimensions normalized to the supplied hardware reference. */
#RX3FxBezel { background: #202020; padding: 0; border: 0; qproperty-layoutSpacing: 0; }
#RX3BeatFxTitle { min-height: 30px; max-height: 30px; background: #303030; font-size: 15px; font-weight: normal; padding: 0; margin: 0; }
#RX3FxContent { background: #202020; border: 0; margin: 0; padding: 0 10px 10px 10px; qproperty-layoutSpacing: 0; qproperty-layoutAlignment: 'AlignTop'; }
#RX3FxSelectorGap, #RX3FxReadoutGap { background: #202020; border: 0; min-height: 12px; max-height: 12px; }
#RX3BeatFxSelector, WEffectSelector#RX3BeatFxSelector { background: #000; color: #eee; font-size: 24px; font-weight: normal; padding: 0 2px; border: 0; }
#RX3BeatFxSelector::drop-down { border: 0; width: 0; }
#RX3BeatFxCaption { min-height: 30px; max-height: 30px; font-size: 12px; color: #888; padding: 0; margin: 0; qproperty-alignment: 'AlignCenter'; }
#RX3FxMaster { background: #000; color: #eee; border: 0; font-size: 24px; font-weight: normal; padding: 0; margin: 0; }
#RX3FxMaster[displayValue="1"] { background: #007ce0; color: #fff; }
#RX3BeatFxReadout { background: #000; border: 0; padding: 0 8px; margin: 0; qproperty-layoutSpacing: 0; qproperty-layoutAlignment: 'AlignTop'; }
#RX3BeatFxBpmRow { qproperty-layoutSpacing: 2; qproperty-layoutAlignment: 'AlignHCenter | AlignVCenter'; }
#RX3BeatFxBpm { font-family: 'Arial'; font-size: 29px; font-weight: normal; qproperty-alignment: 'AlignRight | AlignVCenter'; }
#RX3BeatFxBpmUnit { color: #aaa; font-size: 10px; min-width: 24px; max-width: 24px; padding: 10px 0 0 0; qproperty-alignment: 'AlignLeft | AlignVCenter'; }
#RX3BeatFxMilliseconds { font-family: 'Arial'; font-size: 22px; font-weight: normal; padding: 0 20px 0 0; margin: 0; qproperty-alignment: 'AlignRight | AlignVCenter'; }
#RX3BeatFxBeat { font-size: 20px; font-weight: normal; padding: 0 20px 0 0; margin: 0; qproperty-alignment: 'AlignRight | AlignVCenter'; }
#RX3BeatFxQuantize { font-size: 12px; font-weight: normal; color: #ccc; padding: 0; margin: 0; border-top: 1px solid #111; qproperty-alignment: 'AlignCenter'; }
#RX3ZoomControls #ZoomOutButton { min-width: 14px; max-width: 14px; }
#RX3StatusTabs { min-height: 44px; max-height: 44px; background: #000; border: 1px solid #777; padding: 2px; margin: 0; }
#RX3StatusTabs #RX3StatusTab { min-height: 36px; max-height: 36px; margin: 0; padding: 0; font-size: 18px; font-weight: normal; background: #000; color: #888; }
#RX3StatusTabs #RX3StatusTab[displayValue="1"] { background: #9b9e99; color: #101010; }
