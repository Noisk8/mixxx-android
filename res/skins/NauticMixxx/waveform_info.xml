<Template>
      <WidgetGroup>
        <ObjectName>WaveformInfo</ObjectName><Rx3DeckSelect><Variable name="channel"/></Rx3DeckSelect><Rx3Deck><Variable name="channel"/></Rx3Deck><Connection><ConfigKey>[RX3Display],active<Variable name="channel"/></ConfigKey><BindProperty>highlight</BindProperty></Connection>
        <Layout>vertical</Layout>
        <Size>176f,0me</Size>
        <Children>
          <Label>
            <ObjectName>WaveformInfoDeckTitle</ObjectName>
            <Text>DECK <Variable name="channel"/></Text>
            <Size>0me,28f</Size>
          </Label>
          <WidgetGroup>
            <ObjectName>WaveformInfo_Header</ObjectName>
            <Layout>horizontal</Layout>
            <Size>0me,36f</Size>
            <Children>
              <Label><ObjectName>WaveformInfoUsbIcon</ObjectName><Text></Text></Label>
              <Label>
                <ObjectName>WaveformInfoSource</ObjectName>
                <Text>USB1</Text>
              </Label>

            </Children>
          </WidgetGroup>
          <WidgetGroup>
            <ObjectName>WaveformInfo_Data_Container</ObjectName>
            <Layout>vertical</Layout>
            <Size>0me,25me</Size>
            <Children>
              <WidgetGroup>
                <ObjectName>WaveformInfo_Key_Container</ObjectName>
                <Layout>horizontal</Layout>
                <Size>0me,36f</Size>
                <Children>
                  <Label>
                    <ObjectName>WaveformInfoCaption</ObjectName>
                    <Text>♭♯</Text>
                  </Label>
                  <Key>
                    <ObjectName>WaveformInfo_Key</ObjectName>
                    <TooltipId>visual_key</TooltipId>
                    <Connection>
                      <ConfigKey>[Channel<Variable name="channel"/>],visual_key</ConfigKey>
                    </Connection>
                  </Key>
                </Children>
              </WidgetGroup>
              <WidgetGroup>
                <ObjectName>WaveformInfo_Bars_Container</ObjectName>
                <Layout>horizontal</Layout>
                <Size>0me,34f</Size>
                <Children>
                  <NumberPos>
                    <ObjectName>WaveformInfo_Bars</ObjectName>
                    <Channel><Variable name="channel"/></Channel>
                    <Rx3Format>countdown</Rx3Format>
                    <Connection><ConfigKey>[RX3Display],master<Variable name="channel"/></ConfigKey><BindProperty>highlight</BindProperty></Connection>
                    <Connection><ConfigKey>[Channel<Variable name="channel"/>],playposition</ConfigKey></Connection>
                  </NumberPos>
                </Children>
              </WidgetGroup>
              <WidgetGroup>
                <ObjectName>WaveformInfo_Jump_Container</ObjectName>
                <Connection><ConfigKey>[Channel<Variable name="channel"/>],loop_enabled</ConfigKey><BindProperty>visible</BindProperty></Connection>
                <Layout>horizontal</Layout>
                <Size>0me,36f</Size>
                <Children>
                  <Label>
                    <ObjectName>WaveformInfoCaption</ObjectName>
                    <Text>↪</Text>
                    <Connection><ConfigKey>[RX3Display],master<Variable name="channel"/></ConfigKey><BindProperty>highlight</BindProperty></Connection>
                  </Label>
                  <Number>
                    <ObjectName>WaveformInfoJump</ObjectName>
                    <Rx3Format>loop</Rx3Format>
                    <Connection><ConfigKey>[RX3Display],master<Variable name="channel"/></ConfigKey><BindProperty>highlight</BindProperty></Connection>
                    <NumberOfDigits>0</NumberOfDigits>
                    <Connection>
                      <ConfigKey>[Channel<Variable name="channel"/>],beatloop_size</ConfigKey>
                    </Connection>
                  </Number>
                </Children>
              </WidgetGroup>



            </Children>
          </WidgetGroup>
        </Children>
      </WidgetGroup>
</Template>
