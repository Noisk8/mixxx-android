<!DOCTYPE template>
<Template>
  <WidgetGroup>
    <ObjectName>RX3ModePage</ObjectName>
    <Layout>vertical</Layout>
    <Children>
      <Label><ObjectName>RX3ModeTitle</ObjectName><Rx3ModeTitle>true</Rx3ModeTitle><Text><Variable name="title"/></Text><Size>0me,16f</Size></Label>
      <WidgetGroup><ObjectName>RX3ModeTitleGap</ObjectName><Size>0me,8f</Size></WidgetGroup>
      <WidgetGroup>
        <ObjectName>RX3ModePadRow</ObjectName><Layout>horizontal</Layout><Size>0me,18f</Size>
        <Children>
          <Template src="skin:rx3_status_hotcue_pad.xml"><SetVariable name="channel"><Variable name="channel"/></SetVariable><SetVariable name="hotcue">1</SetVariable><SetVariable name="label">A</SetVariable></Template>
          <Template src="skin:rx3_status_hotcue_pad.xml"><SetVariable name="channel"><Variable name="channel"/></SetVariable><SetVariable name="hotcue">2</SetVariable><SetVariable name="label">B</SetVariable></Template>
          <Template src="skin:rx3_status_hotcue_pad.xml"><SetVariable name="channel"><Variable name="channel"/></SetVariable><SetVariable name="hotcue">3</SetVariable><SetVariable name="label">C</SetVariable></Template>
          <Template src="skin:rx3_status_hotcue_pad.xml"><SetVariable name="channel"><Variable name="channel"/></SetVariable><SetVariable name="hotcue">4</SetVariable><SetVariable name="label">D</SetVariable></Template>
        </Children>
      </WidgetGroup>
      <WidgetGroup><ObjectName>RX3ModeRowGap</ObjectName><Size>0me,10f</Size></WidgetGroup>
      <WidgetGroup>
        <ObjectName>RX3ModePadRow</ObjectName><Layout>horizontal</Layout><Size>0me,18f</Size>
        <Children>
          <Template src="skin:rx3_status_hotcue_pad.xml"><SetVariable name="channel"><Variable name="channel"/></SetVariable><SetVariable name="hotcue">5</SetVariable><SetVariable name="label">E</SetVariable></Template>
          <Template src="skin:rx3_status_hotcue_pad.xml"><SetVariable name="channel"><Variable name="channel"/></SetVariable><SetVariable name="hotcue">6</SetVariable><SetVariable name="label">F</SetVariable></Template>
          <Template src="skin:rx3_status_hotcue_pad.xml"><SetVariable name="channel"><Variable name="channel"/></SetVariable><SetVariable name="hotcue">7</SetVariable><SetVariable name="label">G</SetVariable></Template>
          <Template src="skin:rx3_status_hotcue_pad.xml"><SetVariable name="channel"><Variable name="channel"/></SetVariable><SetVariable name="hotcue">8</SetVariable><SetVariable name="label">H</SetVariable></Template>
        </Children>
      </WidgetGroup>
    </Children>
  </WidgetGroup>
</Template>
